# --- Supabase (required) ---
# Dashboard -> Project Settings -> API
# Use the LEGACY "anon public" and "service_role" JWT keys (long eyJ... strings),
# not the new sb_publishable/sb_secret keys.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- AI assistant (optional — safe fallback when missing) ---
# Never commit real keys. If a key is exposed, revoke it at platform.openai.com immediately.
OPENAI_API_KEY=

# --- Twilio SMS (optional — safe fallback when missing) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- GoHighLevel CRM handoff (server-only; OFF unless explicitly enabled) ---
# Enquiries are always saved to Supabase first; these only control the push to GHL.
GHL_HANDOFF_ENABLED=false
# GHL sub-account → Settings → Private Integrations. Scopes: contacts.write, opportunities.readonly, opportunities.write
GHL_PRIVATE_INTEGRATION_TOKEN=
GHL_LOCATION_ID=
# Ids of the "Open Limits Sales" pipeline and its stages (read them with `npm run crm:inspect` in open-limits-growth)
GHL_PIPELINE_ID=
GHL_STAGE_NEW_ENQUIRY_ID=
GHL_STAGE_CONSULTATION_BOOKED_ID=
# Optional custom-field ids (contact fields); a missing id simply skips that field
GHL_FIELD_PROJECT_TYPE_ID=
GHL_FIELD_LEAD_SOURCE_ID=
GHL_FIELD_UTM_CAMPAIGN_ID=
GHL_FIELD_TRACKING_REF_ID=
GHL_FIELD_PREFERRED_LANGUAGE_ID=
# Protects GET /api/crm/handoff (retry worker). At least 32 random characters.
CRON_SECRET=
