# --- Supabase (required) ---
# Dashboard -> Project Settings -> API
# Use the LEGACY "anon public" and "service_role" JWT keys (long eyJ... strings),
# not the new sb_publishable/sb_secret keys.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- AI assistant (optional — safe fallback when missing) ---
# Never commit real keys. If a key is exposed, revoke it at platform.openai.com immediately.
OPENAI_API_KEY=

# --- Twilio SMS (optional — safe fallback when missing) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
