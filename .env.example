# --- Supabase (required) ---
# Dashboard -> Project Settings -> API
# Use the LEGACY "anon public" and "service_role" JWT keys (long eyJ... strings),
# not the new sb_publishable/sb_secret keys.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- AI assistant (optional — safe fallback when missing) ---
# Never commit real keys. If a key is exposed, revoke it at platform.openai.com immediately.
OPENAI_API_KEY=

# --- Twilio SMS (optional — safe fallback when missing) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- GoHighLevel CRM handoff (server-only; OFF unless explicitly enabled) ---
# Enquiries are always saved to Supabase first; these only control the push to GHL.
# The handoff also stays off in code until PRIVACY_NOTICE_STATUS (lib/crm/enquiry.ts) is "APPROVED".
GHL_HANDOFF_ENABLED=false
# SECRET. GHL sub-account -> Settings -> Private Integrations (website token).
# Scopes: contacts.readonly, contacts.write, opportunities.readonly, opportunities.write
GHL_PRIVATE_INTEGRATION_TOKEN=
# Non-secret ids (verified live 2026-11-21): sub-account, "Open Limits Sales" pipeline and stages
GHL_LOCATION_ID=ya27Ye5RJURn4bLEfJu3
GHL_PIPELINE_ID=P8fVDVX7SENExn1EaU9Q
GHL_STAGE_NEW_ENQUIRY_ID=3986a6e9-455c-4a0a-bf4b-91e36877deaf
GHL_STAGE_CONSULTATION_BOOKED_ID=00037a88-e3b1-4430-bd6d-07ea60f9665a
# Custom-field ids (contact fields + opportunity tracking ref); a missing id simply skips that field
GHL_FIELD_PROJECT_TYPE_ID=b8KwOwrQamKQlPjQWTkL
GHL_FIELD_LEAD_SOURCE_ID=881XTseVXr4lJG5DHUA2
GHL_FIELD_UTM_CAMPAIGN_ID=hciysrACNgIMa5wW3v7q
GHL_FIELD_TRACKING_REF_ID=hlsKAp9uWju9rpuxvmQX
GHL_FIELD_PREFERRED_LANGUAGE_ID=DbQKXnYJZ3DlJgRA6pzq
GHL_OPP_FIELD_TRACKING_REF_ID=DASbs7krhS88qE7ormsO
# SECRET. Protects GET /api/crm/handoff (retry worker; Vercel Cron sends it automatically). >= 32 random chars.
CRON_SECRET=
# Client SMS on booking accept/reject (Twilio). Off until client messaging is approved.
BOOKING_SMS_ENABLED=false
